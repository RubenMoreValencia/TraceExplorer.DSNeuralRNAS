                    height = "520px"), h4("Índice de evidencia"), 
                  DTOutput("article_comparison_index"), h4("FormalSpec existente"), 
                  DTOutput("article_comparison_fs"), h4("Fronteras del artículo"), 
                  DTOutput("article_comparison_boundaries"), 
