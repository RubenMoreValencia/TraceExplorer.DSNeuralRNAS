            if (is.null(ev)) {
                return(p(class = "te-muted", "Seleccione un punto de la trayectoria 3D para inspeccionarlo."))
            }
            k <- ev$key
            if (is.null(k) && !is.null(ev$customdata)) {
                k <- ev$customdata
            }
